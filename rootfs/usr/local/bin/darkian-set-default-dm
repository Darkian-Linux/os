#!/bin/sh
# Darkian Linux - choose the default display manager for the installed system.
#
# The live image ships SDDM with the Darkian-branded theme and it can launch
# any session, so Darkian keeps SDDM as the display manager for every desktop
# (no Debian-branded GDM/LightDM greeter). This runs from the Calamares
# shellprocess job after the chosen desktop is installed.
set -eu

for dm in sddm gdm3 lightdm; do
    case "$dm" in
        gdm3)    bin="/usr/sbin/gdm3" ;;
        lightdm) bin="/usr/sbin/lightdm" ;;
        sddm)    bin="/usr/bin/sddm" ;;
    esac

    if [ -x "$bin" ]; then
        printf '%s\n' "$bin" > /etc/X11/default-display-manager
        if [ -e "/lib/systemd/system/$dm.service" ]; then
            ln -sf "/lib/systemd/system/$dm.service" /etc/systemd/system/display-manager.service
        fi
        exit 0
    fi
done

exit 0
