# Darkian Linux 13 "Snake" — build configuration
# shellcheck shell=bash

DISTRO_NAME="Darkian Linux"
DISTRO_VERSION="13"
DISTRO_CODENAME="Snake"
HOMEPAGE="https://darkian.xyz"

# Live session identity
HOSTNAME="darkianlive"
LIVE_USERNAME="darkian"
LIVE_USER_FULLNAME="Darkian Live User"
LIVE_PASSWORD="darkianlinux"

# Base ISO (Debian 13 live KDE, SHA256-verified)
BASE_ISO="/mnt/c/Users/lordpipon/Downloads/debian-live-13.7.0-amd64-kde.iso"

# Build workspace — must be on the native Linux filesystem (not /mnt/*)
WORK_DIR="/var/tmp/darkian-build"

# Output image name
OUTPUT_ISO_NAME="Darkian-Linux-13-snake-amd64.iso"

# --- Options ---------------------------------------------------------------

# XanMod kernel for the *installed* system. The live session always boots the
# stock Debian kernel from the ISO, so this is safe: if the installed system
# ever misbehaves, the stock kernel remains in the GRUB menu.
ENABLE_XANMOD="true"

# Steam / Prism Launcher / Proton managers are NOT preinstalled (keeps the
# ISO small; the Flathub remote is set up so they can be installed on demand).
ENABLE_STEAM="false"

# "mozilla" = Firefox from packages.mozilla.org (not ESR), falls back to
# firefox-esr automatically if the Mozilla repo fails.
FIREFOX_CHANNEL="mozilla"

# Squashfs compressor. xz gives the smallest image (slower to build); zstd is
# much faster to unpack (better Calamares install speed) at a size cost.
SQUASHFS_COMPRESS="xz"
